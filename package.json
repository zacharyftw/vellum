{
  "name": "vellum",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--dns-result-order=ipv4first next dev",
    "build": "next build",
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun scripts/e2e-invoice.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "check:pool": "bun scripts/verify-pool-config.ts",
    "cairo:check": "bun scripts/check-cairo-toolchain.ts",
    "cairo:build": "bun run cairo:check && cd cairo && scarb build",
    "cairo:test": "bun run cairo:check && cd cairo && snforge test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.0.1",
    "@react-spring/web": "^10.0.3",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@react-three/postprocessing": "^3.0.4",
    "@starknet-io/get-starknet-discovery": "6.0.2",
    "@starknet-io/get-starknet-wallet-standard": "6.0.2",
    "drizzle-orm": "^0.44.6",
    "lenis": "^1.3.19",
    "next": "16.2.0",
    "postprocessing": "^6.39.2",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "resize-observer-polyfill": "^1.5.1",
    "server-only": "^0.0.1",
    "spring-text-engine": "^0.1.5",
    "starknet": "10.4.0",
    "three": "^0.185.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@starknet-io/types-js": "0.10.3",
    "@tailwindcss/postcss": "^4",
    "@types/bun": "^1.3.14",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.185.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.6",
    "eslint": "^9",
    "eslint-config-next": "16.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
