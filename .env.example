# ─── Site ────────────────────────────────────────────────────────────────────
# Public origin, no trailing slash. Drives canonical URLs, OG tags, sitemap.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ─── Starknet ────────────────────────────────────────────────────────────────
# Alchemy Starknet API key — the KEY ONLY, not a full URL. Free at alchemy.com.
# The RPC endpoints in src/lib/starknet/networks.ts append it.
NEXT_PUBLIC_PROVIDER_URL=

# Deployed InvoiceRegistry per network. "0x0" = not deployed there, which
# disables on-chain anchoring on that network instead of failing a transaction.
NEXT_PUBLIC_INVOICE_REGISTRY_MAINNET=0x0
NEXT_PUBLIC_INVOICE_REGISTRY_SEPOLIA=0x0

# STRK20 privacy pool per network. Only needed to READ — the wallet supplies
# this address itself when sending. Setting it lets the payment page check
# whether a supplier has registered a viewing key before the buyer pays;
# without it, that failure only surfaces as a reverted transaction.
NEXT_PUBLIC_STRK20_POOL_MAINNET=0x0
NEXT_PUBLIC_STRK20_POOL_SEPOLIA=0x0

# ─── Database ────────────────────────────────────────────────────────────────
# Neon Postgres. Holds ENCRYPTED invoice blobs only — decryption keys never
# leave the browser, so a dump of this database discloses nothing.
DATABASE_URL=

# ─── Optional ────────────────────────────────────────────────────────────────
# Upstream the contact endpoint forwards leads to (CRM / webhook).
CONTACT_ENDPOINT=
