# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — `.env` alone does NOT cover `.env.local`, which is where the
# Neon connection string and Alchemy key actually live.
.env
.env.local
.env.*.local
!.env.example

# vercel
.vercel

# cairo
/cairo/target/
/cairo/.snfoundry_cache/

# typescript
*.tsbuildinfo
next-env.d.ts
